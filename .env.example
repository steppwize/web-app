# OAuth client ID for the Google Drive backup/restore option (src/backup/googleAuth.ts).
# Create a Web application OAuth client in Google Cloud Console (APIs & Services > Credentials),
# with the Drive API enabled and scope https://www.googleapis.com/auth/drive.file on the consent
# screen. This is a public identifier, not a secret — do NOT set a client secret here, the
# browser-only token flow this app uses never sends one.
VITE_GOOGLE_CLIENT_ID=
